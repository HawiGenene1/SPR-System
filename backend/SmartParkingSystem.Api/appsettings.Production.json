{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST:-127.0.0.1};Port=${DB_PORT:-5432};Database=${DB_NAME:-SmartParkingDb};Username=${DB_USER:-postgres};Password=${DB_PASSWORD};SSL Mode=Prefer;Trust Server Certificate=true;Timeout=30;Command Timeout=30"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER:-SmartParkingSystem}",
    "Audience": "${JWT_AUDIENCE:-SmartParkingSystemUsers}",
    "ExpiryInMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "${FRONTEND_URL:-https://smartparking.company.com}"
    ]
  }
}
